# Copy this file to .env and replace the two placeholders below.
# Azure Portal > your Azure OpenAI resource > Keys and Endpoint / Endpoints.
AZURE_OPENAI_ENDPOINT=your_azure_endpoint
# Azure Portal > your Azure OpenAI resource > Keys and Endpoint > Key 1 or Key 2.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Exact deployment NAME from Foundry > Model deployments (not the model version).
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
